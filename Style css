/* ---------- Basic Reset ---------- */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --main: #b5391e;
  --main-dark: #8f2b15;
  --green: #2e8b57;
  --red: #d64545;
  --blue: #3a6ea5;
  --bg: #fff8f0;
  --text: #333;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
}

/* ---------- Header ---------- */
header {
  background: var(--main);
  color: white;
  text-align: center;
  padding: 20px 15px;
}

header h1 {
  font-size: 1.5rem;
}

header p {
  font-size: 0.95rem;
  opacity: 0.9;
  margin-top: 4px;
}

/* ---------- Navigation ---------- */
nav {
  background: var(--main-dark);
  display: flex;
  overflow-x: auto;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-btn {
  flex: 1;
  min-width: 110px;
  padding: 14px 10px;
  background: none;
  border: none;
  color: white;
  font-size: 0.95rem;
  cursor: pointer;
  border-bottom: 4px solid transparent;
}

.nav-btn:hover {
  background: rgba(255, 255, 255, 0.1);
}

.nav-btn.active {
  border-bottom-color: #ffd166;
  font-weight: bold;
}

/* ---------- Main Layout ---------- */
main {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px 15px;
}

.section {
  display: none;
}

.section.active {
  display: block;
}

h2 {
  margin-bottom: 15px;
  color: var(--main-dark);
}

/* ---------- Cards ---------- */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  border-left: 6px solid #ccc;
}

.card-title {
  font-size: 0.95rem;
  color: #666;
}

.card-value {
  font-size: 1.8rem;
  font-weight: bold;
  margin-top: 6px;
}

.income-card  { border-left-color: var(--green); }
.expense-card { border-left-color: var(--red); }
.profit-card  { border-left-color: #f0a500; }
.count-card   { border-left-color: var(--blue); }

.income-card .card-value  { color: var(--green); }
.expense-card .card-value { color: var(--red); }

/* ---------- Forms ---------- */
.form-box {
  background: white;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  max-width: 500px;
}

.form-box label {
  display: block;
  margin-top: 12px;
  margin-bottom: 4px;
  font-weight: bold;
  font-size: 0.95rem;
}

input,
select {
  width: 100%;
  padding: 10px;
  font-size: 1rem;
  border: 1px solid #ccc;
  border-radius: 8px;
  background: white;
}

input:focus,
select:focus {
  outline: none;
  border-color: var(--main);
}

.error {
  color: var(--red);
  font-size: 0.9rem;
  margin-top: 10px;
  min-height: 20px;
}

/* ---------- Buttons ---------- */
.btn {
  padding: 11px 20px;
  font-size: 1rem;
  border: none;
  border-radius: 8px;
  color: white;
  cursor: pointer;
  background: var(--main);
}

.form-box .btn {
  width: 100%;
  margin-top: 8px;
}

.btn:hover { opacity: 0.9; }

.btn-green { background: var(--green); }
.btn-red   { background: var(--red); }
.btn-gray  { background: #777; }

.delete-btn {
  background: var(--red);
  color: white;
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
}

/* ---------- Filters ---------- */
.filters {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
  margin-bottom: 15px;
}

/* ---------- Table ---------- */
.table-wrap {
  overflow-x: auto;
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 650px;
}

th, td {
  padding: 12px;
  text-align: left;
  border-bottom: 1px solid #eee;
  font-size: 0.95rem;
}

th {
  background: #f3e3d3;
}

.type-income  { color: var(--green); font-weight: bold; }
.type-expense { color: var(--red); font-weight: bold; }

.empty {
  display: none;
  text-align: center;
  padding: 20px;
  color: #777;
}

/* ---------- Reports ---------- */
.report-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 10px;
}

.report-btn {
  background: #999;
}

.report-btn.active {
  background: var(--main);
}

.report-note {
  margin-bottom: 15px;
  color: #666;
  font-size: 0.9rem;
}

/* ---------- Footer ---------- */
footer {
  text-align: center;
  padding: 20px;
  color: #777;
  font-size: 0.9rem;
}

/* ---------- Small Screens ---------- */
@media (max-width: 600px) {
  header h1 { font-size: 1.25rem; }
  .card-value { font-size: 1.5rem; }
  .nav-btn { font-size: 0.85rem; min-width: 100px; }
}
